# Variables de Entorno para Abundance Clinic OS en Vercel
# Puedes importar este archivo directamente con el botón "Import .env" en Vercel

NODE_VERSION=22.x
CLINIC_ENV=production
# Reemplaza con la Project URL de Supabase (Settings > General o Data API)
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
# Pega tu Publishable Key copiada de Supabase
SUPABASE_ANON_KEY=sb_publishable_...
# Pega tu Secret Key copiada de Supabase
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
