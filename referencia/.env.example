# ==============================================================================
# CLINIC-OS - ENVIRONMENT VARIABLES TEMPLATE (PRODUCTION & TEST READY)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE / POSTGRESQL (RLS MULTI-TENANT & CONNECTION POOLING)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection String (URI / Transaction Pooler port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (NEXTAUTH V5 & AES-256)
# ------------------------------------------------------------------------------
AUTH_SECRET="generate_a_random_32_bytes_base64_string_with_openssl"
NEXTAUTH_URL="http://localhost:3000"
PHI_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
AUDIT_LOG_SALT="clinic-os-immutable-salt-value-for-tamper-resistance"

# ------------------------------------------------------------------------------
# 3. GOHIGHLEVEL (GHL API V2 - CRM & FUNNELS)
# ------------------------------------------------------------------------------
# En HighLevel: Settings -> Business Info -> Location ID & Private Integrations / API Key
GHL_API_BASE_URL="https://services.leadconnectorhq.com"
GHL_API_VERSION="2021-07-28"
GHL_LOCATION_ID="loc_your_clinic_location_id"
GHL_API_KEY="pit-your-private-integration-token"
GHL_CLIENT_ID="your_ghl_oauth_app_client_id"
GHL_CLIENT_SECRET="your_ghl_oauth_app_client_secret"

# ------------------------------------------------------------------------------
# 4. WHATSAPP BUSINESS CLOUD API (META GRAPH API)
# ------------------------------------------------------------------------------
# En Meta for Developers: WhatsApp -> API Setup & Webhooks Configuration
WHATSAPP_APP_ID="your_meta_app_id"
WHATSAPP_APP_SECRET="your_meta_app_secret"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_ACCESS_TOKEN="EAA..."
WHATSAPP_VERIFY_TOKEN="clinic_os_meta_verify_token_2026"

# ------------------------------------------------------------------------------
# 5. GOOGLE CALENDAR API (BIDIRECTIONAL REAL-TIME SYNC)
# ------------------------------------------------------------------------------
# En Google Cloud Console: APIs & Services -> Enable Google Calendar API -> Service Account / OAuth
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_google_client_secret"
GOOGLE_CALENDAR_ID="primary"
GOOGLE_SERVICE_ACCOUNT_EMAIL="clinic-calendar-sync@your-project.iam.gserviceaccount.com"

# ------------------------------------------------------------------------------
# 6. PROACTIVE AI AGENT (LLM ORCHESTRATION & COMPLIANCE ZDR)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o"
OPENAI_ORG_ID="org-your-organization"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"
GEMINI_API_KEY="your-google-gemini-api-key"
